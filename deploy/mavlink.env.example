# Copied to /etc/haav/mavlink.env by deploy/install.sh (not overwritten on re-run). No secrets here.
# Edit, then: sudo systemctl restart haav-mavlink

# Where the MAVLink stream comes from:
#   SiK radio on USB:          /dev/serial/by-id/usb-...   (ls -l /dev/serial/by-id/), baud 57600
#   Pixhawk USB directly:      /dev/serial/by-id/usb-ArduPilot_...  (baud is ignored on USB)
#   Pixhawk on a Pi UART:      /dev/ttyAMA3 etc., baud = SERIALn_BAUD on the Pixhawk
#   via mavlink-router (later): udpin:127.0.0.1:14560
HAAV_MAV_DEVICE=/dev/ttyUSB0
HAAV_MAV_BAUD=57600

# Name the Pixhawk outputs you care about (SERVOn). ArduRover skid steering defaults:
# SERVO1 = ThrottleLeft, SERVO3 = ThrottleRight. Check SERVOn_FUNCTION in Mission Planner/QGC.
HAAV_MAV_SERVO_OUTPUTS=1:port,3:stbd

# Metrics endpoint Alloy scrapes (keep on localhost).
HAAV_MAV_LISTEN=127.0.0.1:9102

# 0 = use the first autopilot heard. Set if more than one vehicle is on the link.
HAAV_MAV_SYSID=0
