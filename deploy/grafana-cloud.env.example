# Copy to /etc/haav/grafana-cloud.env on the Pi (deploy/install.sh does this) and fill in.
# Grafana Cloud portal -> your stack -> Prometheus -> "Send metrics":
GRAFANA_CLOUD_PROM_URL=https://prometheus-prod-XX-prod-us-central-0.grafana.net/api/prom/push
GRAFANA_CLOUD_PROM_USER=000000
# Access policy token with the metrics:write scope (starts with glc_). Never commit the real one.
GRAFANA_CLOUD_API_TOKEN=glc_REPLACE_ME
